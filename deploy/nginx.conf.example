server {
    listen 80;
    server_name repo-review.example.com;

    client_max_body_size 10M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace, rather than append, so clients cannot spoof the first address
        # used as the application rate-limit key.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Sync /review can run up to REPO_REVIEW_JOB_TIMEOUT (600s).
        proxy_connect_timeout 300;
        proxy_send_timeout 650;
        proxy_read_timeout 650;
    }
}
