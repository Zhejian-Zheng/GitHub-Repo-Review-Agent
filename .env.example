# Install provider integrations with: python -m pip install -e ".[all]"
# Agent mode requires a tool-capable model; rules-only mode needs no API key.
# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional OpenRouter provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=GitHub Repo Review Agent

# Optional Anthropic (Claude) provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional local Ollama provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Public web deployment controls.
# Defaults are conservative for public deployments. Set local targets to true only for
# trusted local development or private networks.
REPO_REVIEW_ALLOW_LOCAL_TARGETS=false
REPO_REVIEW_RATE_LIMIT_PER_MINUTE=30
# Trust the X-Forwarded-For header for rate-limit client identity. Keep true only
# when running behind a trusted proxy that sets it; set false if clients reach the
# app directly, otherwise the header can be spoofed to bypass rate limiting.
REPO_REVIEW_TRUST_FORWARDED_FOR=true
REPO_REVIEW_MAX_FILES_LIMIT=1000
REPO_REVIEW_MAX_FILE_SIZE_LIMIT=1000000
REPO_REVIEW_CORS_ORIGINS=

# Optional API token for private demos or API-only deployments.
# If set, clients must send Authorization: Bearer <token> or X-Repo-Review-Token.
REPO_REVIEW_API_TOKEN=

# Optional Supabase history storage.
# Use the service role key only from trusted server-side code or local CLI runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional frontend Supabase Auth.
# VITE_* values are safe to expose to browser builds when they contain the public anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
VITE_REPO_REVIEW_API_TOKEN=

# Require Supabase login before the web API accepts review requests.
REPO_REVIEW_REQUIRE_AUTH=false
# Seconds to cache a verified Supabase token, avoiding a token-verification
# round-trip on every request. A revoked token stays accepted until its cache
# entry expires, so keep this small. Set 0 to disable caching.
REPO_REVIEW_AUTH_CACHE_TTL=60

# Optional Langfuse tracing: install with python -m pip install -e ".[langfuse]".
# Disabled unless explicitly enabled and all three connection fields are set.
# Content is omitted: no prompts, source, responses, metadata or raw errors.
REPO_REVIEW_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Review jobs: both /review and /review/jobs share admission limits.
REPO_REVIEW_JOB_STORE=auto
REPO_REVIEW_JOB_WORKERS=2
REPO_REVIEW_JOB_MAX_PENDING=20
# Counts queued and running jobs; anonymous requests share one bucket.
REPO_REVIEW_JOB_PER_USER_LIMIT=2
# Total isolated review execution deadline, including cloning and history writes.
REPO_REVIEW_JOB_TIMEOUT=600
REPO_REVIEW_CLONE_TIMEOUT=120
# Completed/failed job records and results expire after this many seconds.
REPO_REVIEW_JOB_RESULT_TTL=86400

# Daily UTC review/AI-question admissions per owner; cancelled jobs still count.
REPO_REVIEW_DAILY_JOB_LIMIT=100
