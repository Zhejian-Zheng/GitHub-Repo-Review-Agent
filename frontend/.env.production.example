# Public browser build configuration.
# These values are embedded into the static frontend bundle.

# Render/Fly/Railway/VPS FastAPI backend URL, without a trailing slash.
VITE_API_BASE_URL=https://github-repo-review-agent-api.onrender.com

# Supabase project URL and public anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# GitHub Pages repository path. Leave as / for Vercel, Netlify, or custom domains.
VITE_BASE_PATH=/GitHub-Repo-Review-Agent/

# Optional. Where Supabase email confirmation links should return.
# Defaults to the current frontend origin + VITE_BASE_PATH when omitted.
VITE_AUTH_REDIRECT_URL=https://your-github-user.github.io/GitHub-Repo-Review-Agent/

# Optional. This is visible in the browser bundle, so do not treat it as a secret.
VITE_REPO_REVIEW_API_TOKEN=
